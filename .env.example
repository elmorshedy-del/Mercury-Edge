# Railway PostgreSQL plugin injects DATABASE_URL automatically.
DATABASE_URL=

# Protects POST /api/ingest and POST /api/backtests.
INGEST_TOKEN=replace-with-a-long-random-value

# The Weather Company forecast API. Required for the immutable TWC market anchor.
# Add the key as TWC_API_KEY in Railway; WEATHER_API_KEY is accepted as a legacy alias.
TWC_API_KEY=

# Optional: authenticated Kalshi access. Public market discovery and candle history work without these.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=

# Source identification requested by NOAA APIs.
SOURCE_USER_AGENT=MercuryEdge/0.1 research@example.com

# Set to 1 only when you want the scheduled worker to ingest current data.
LIVE_INGEST_ENABLED=0

# Worker cadence; 60000 polls once per minute.
POLL_INTERVAL_MS=60000

# Start narrow; expand only after provider-rate and cost checks.
INGEST_STATIONS=KNYC,KPHL

# Persistent research control-plane worker.
JOB_POLL_INTERVAL_MS=5000
