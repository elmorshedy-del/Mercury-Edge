{
  "name": "mercury-edge",
  "version": "0.1.0",
  "private": true,
  "description": "Timestamp-faithful weather-market latency research and backtesting",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "tsx scripts/migrate.ts && next start -p ${PORT:-3000}",
    "lint": "eslint . --ignore-pattern .next",
    "test": "node --import tsx --test tests/*.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "ingest": "tsx scripts/ingest.ts",
    "worker": "tsx scripts/worker.ts",
    "jobs:worker": "tsx scripts/job-worker.ts",
    "backfill": "tsx scripts/backfill.ts",
    "backtest": "tsx scripts/backtest.ts",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.2.6",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
